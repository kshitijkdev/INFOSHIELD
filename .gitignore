# InfoShield Root .gitignore
# Environment & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
venv/
env/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Runtime Uploads & Outputs (Keep folder structure via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep
backend/outputs/*
!backend/outputs/.gitkeep
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Temporary & Local Logs
*.log
*.tmp

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Backup Archives
*.zip
backups/
