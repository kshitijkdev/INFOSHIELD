# ==============================================================================
# InfoShield — Environment Variables Template
# Copy to .env for local development or configure in Render Dashboard
# ==============================================================================

# Supabase Credentials (keep private on backend only, NEVER expose to frontend)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# Production Environment & CORS
ENV=production
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://your-infoshield-frontend.vercel.app,http://localhost:3000
ALLOWED_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Optional: Path to custom Tesseract binary (if not in standard PATH)
# TESSERACT_PATH=/usr/bin/tesseract

# Writable Temporary Processing Directories (for containers/cloud)
# UPLOAD_DIR=/tmp/infoshield/uploads
# OUTPUT_DIR=/tmp/infoshield/outputs

# Data Privacy & Retention
CLEANUP_SCAN_TEMP=true
CLEANUP_ORIGINALS=false
